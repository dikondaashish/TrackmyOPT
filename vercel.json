    "buildCommand": "next build",
    "outputDirectory": ".next",
    "framework": "nextjs",
    "crons": [
        {
            "path": "/api/cron/check-case-status",
            "schedule": "0 14 * * *"
        },
        {
            "path": "/api/cron/scan-nearby-cases",
            "schedule": "*/15 * * * *"
        }
    ]
}