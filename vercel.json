{
  "version": 2,
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/web/$1"
    }
  ],
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/cron/send-daily-reminders",
      "schedule": "0 13 * * *"
    }
  ]
}