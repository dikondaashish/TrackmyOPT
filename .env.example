# =============================================================================
# TrackMyOPT — Environment variables reference
# =============================================================================
# Copy to .env.local for local dev. In production, set these in Vercel
# Project Settings → Environment Variables.
#
# Grouped by feature so missing-secret errors at runtime are easy to fix.
# Required vs optional is determined by `apps/web/lib/env.ts` (zod schema).
# =============================================================================

# -------------------------------------------------------------
# CORE — required for any deployment
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...   # service role — server only
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # canonical site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL_LOGO_URL=http://localhost:3000/logo.png
JWT_SIGNING_SECRET=change-me-to-32-char-or-longer-string
# Generate once with: openssl rand -base64 32
# Server-only AES-256-GCM key for optional private job-application answers.
PRIVATE_APPLICATION_ANSWERS_ENCRYPTION_KEY=
NEXT_PUBLIC_CHROME_EXTENSION_ID=hfljbefkccdmlnhclfojlafipjnjbajm
# Optional comma-separated unpacked/dev IDs accepted by extension-facing CORS routes.
CHROME_EXTENSION_IDS=

# -------------------------------------------------------------
# STRIPE — required to enable premium billing
# -------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Undiscounted recurring Stripe catalog Prices. Product-scoped promotion codes
# produce the exact limited-time offer and are validated again at checkout:
# Pro $7.99/month or $79.99/year → $4.99/month or $49.99/year.
# Dedicated $19.99/month or $199.99/year → $14.99/month or $149.99/year.
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
# Active one-time USD $0.99 Price for the once-per-account 7-day Pro introduction.
STRIPE_PRICE_PRO_INTRO=price_...
STRIPE_PRICE_DEDICATED_MONTHLY=price_...
STRIPE_PRICE_DEDICATED_YEARLY=price_...
# Optional active one-time USD $1.00 Price override. By default, checkout uses
# the stable Stripe lookup key `trackmyopt_resume_credit_usd_1`. Quantity equals
# the selected dollar amount (whole dollars from $1 to $100) and grants 10 credits per dollar.
STRIPE_PRICE_RESUME_CREDITS_10=price_...
# Legacy promotion-code variables. Default checkout uses the stable limited-time
# offer codes configured in plan-config.ts, so these are not required.
STRIPE_PROMO_CODE_PRO=
STRIPE_PROMO_CODE_DEDICATED=

# -------------------------------------------------------------
# USCIS API — case status tracker (live production OAuth credentials)
# -------------------------------------------------------------
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
USCIS_TOKEN_URL=https://api.uscis.gov/oauth/accesstoken
USCIS_API_BASE_URL=https://api.uscis.gov/case-status
# USCIS_MOCK is ignored in production. Set to 'true' ONLY in local/preview to
# return canned data instead of hitting USCIS. Leave unset for live API.
USCIS_MOCK=false
NEXT_PUBLIC_USCIS_MOCK=false
# NEARBY_SCAN_ENABLED must remain false unless counsel + USCIS approve neighbor scanning.
# Default off — no runtime override path exists in code.
NEARBY_SCAN_ENABLED=false

# -------------------------------------------------------------
# AWS — Document Vault (S3) + Resume OCR (Textract)
# -------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=trackmyopt-prod-documents

# -------------------------------------------------------------
# AI — Vertex AI for resume + document analysis
# Vertex is the default. On Google Cloud runtimes, Application Default
# Credentials are used automatically. On Vercel, store the complete service
# account key JSON in GOOGLE_SERVICE_ACCOUNT_JSON as a protected server secret.
# -------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Intentional local fallback only. Set GOOGLE_GENAI_USE_VERTEXAI=false before
# using this key; production must remain on Vertex AI for startup credits.
GEMINI_API_KEY=AIza...

# -------------------------------------------------------------
# EMAIL — SMTP (ZeptoMail, Resend SMTP, Hostinger, etc.)
# SMTP_USER is the SMTP login username — never use it as the From address.
# SMTP_FROM_EMAIL must be a sender verified at your provider (e.g. trackmyopt.com).
#
# ZeptoMail example:
#   SMTP_HOST=smtp.zeptomail.com
#   SMTP_PORT=465
#   SMTP_USER=emailapikey
#   SMTP_PASS=<ZeptoMail SMTP password from dashboard — store only in Vercel, never in git>
#
# Resend SMTP example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_USER=resend
#   SMTP_PASS=re_...
# -------------------------------------------------------------
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=emailapikey
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@trackmyopt.com
EMAIL_FROM_NAME=TrackMyOPT
EMAIL_LOGO_URL=https://www.trackmyopt.com/logo.png
CONTACT_EMAIL=support@trackmyopt.com

# -------------------------------------------------------------
# CRON / INTERNAL SECRETS — protect cron-triggered routes
# -------------------------------------------------------------
CRON_SECRET=long-random-string                 # cron-job.org auth (+ Vercel case-status cron)
API_SECRET_KEY=long-random-string              # for /api/cron/check-case-status → backend
SEO_PING_SECRET=long-random-string             # /api/seo/ping admin tool
SEO_VERIFY_BASE=https://www.trackmyopt.com
INDEXNOW_KEY=your-bing-indexnow-key            # IndexNow key (public); /api/seo/ping uses this
EMAIL_LINK_SIGNING_SECRET=long-random-string   # HMAC for click-tracking links

# -------------------------------------------------------------
# ADMIN — server-only bulk email (policy / service announcements)
# -------------------------------------------------------------
ADMIN_SECRET=long-random-min-16-chars          # POST /api/admin/bulk-notification Authorization: Bearer …

# -------------------------------------------------------------
# RATE LIMITING + E-VERIFY CACHE — Upstash Redis
# -------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
# Vercel Marketplace alternatively injects KV_REST_API_URL and KV_REST_API_TOKEN.
# Required in production for the on-demand E-Verify cache, lock, and crawl gate.
EVERIFY_CONTACT_EMAIL=support@trackmyopt.com   # Public scraper User-Agent contact

# -------------------------------------------------------------
# ANALYTICS — PostHog
# -------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_API_KEY=
POSTHOG_SOURCEMAPS_ENABLED=false
POSTHOG_SOURCEMAPS_BATCH_SIZE=100

# -------------------------------------------------------------
# EXTENSION / WEB PUSH
# -------------------------------------------------------------
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/trackmyopt/hfljbefkccdmlnhclfojlafipjnjbajm
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@trackmyopt.com

# -------------------------------------------------------------
# DOCUMENT SECURITY / OCR / LATEX
# -------------------------------------------------------------
# Production document uploads are fail-closed. The Nest API on Render
# (api.trackmyopt.com) now serves these endpoints. Generate matching tokens
# with `openssl rand -hex 32` and set the SAME values on Vercel and Render.
MALWARE_SCAN_URL=https://api.trackmyopt.com/scan
MALWARE_SCAN_TOKEN=
# Local development only. Never set this in Vercel Production.
DOCUMENT_SCAN_MODE=disabled
OCR_TEXTRACT_ENABLED=false
# Required in production. Must be a private HTTPS LaTeX compiler; public
# compiler fallbacks are intentionally not used because resumes contain PII.
LATEX_COMPILER_URL=https://api.trackmyopt.com/builds/sync
LATEX_COMPILER_TOKEN=
DAILY_UPLOAD_LIMIT=20

# -------------------------------------------------------------
# CONTROLLED CRON / RE-ENGAGEMENT FLAGS
# -------------------------------------------------------------
AT_RISK_REENGAGEMENT_ENABLED=false
FREE_RECEIPT_REENGAGEMENT_ENABLED=false
WELCOME_FREE_RESEND_ENABLED=false
POSTHOG_LTV_SYNC_ENABLED=false
POSTHOG_PARTNER_GROUPS_SYNC_ENABLED=false

# -------------------------------------------------------------
# OPTIONAL — local H-1B/LCA ETL scripts (apps/web/scripts/data/)
# Download DOL or ITContractorsUnion dataset; not needed for app runtime.
# -------------------------------------------------------------
# H1B_RAW_DATA_DIR=/path/to/ITContractorsUnion-Main

# -------------------------------------------------------------
# BACKEND (NestJS on Render) — for USCIS batch scrape via cron
# -------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.trackmyopt.com   # NestJS backend base URL
CORS_ORIGINS=http://localhost:3000,https://www.trackmyopt.com
PORT=3000

# Backend-only (Render):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Same tokens as Vercel. Generate with: openssl rand -hex 32
MALWARE_SCAN_TOKEN=
LATEX_COMPILER_TOKEN=
