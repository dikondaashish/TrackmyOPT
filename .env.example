# -------------------------------------------------------------
# FRONTEND VERCEL NEXT.JS (.env.local)
# -------------------------------------------------------------

# Supabase Local or Cloud Details
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Hosting & Frontend URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Payments Integration
STRIPE_SECRET_KEY=sk_test_fake
STRIPE_WEBHOOK_SECRET=whsec_fake
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_fake

# Email Server Notifications (SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_fake
CONTACT_EMAIL=support@trackmyopt.com

# AWS / Textract integrations
AWS_ACCESS_KEY_ID=AKIA_FAKE
AWS_SECRET_ACCESS_KEY=Fake_Secret
AWS_REGION=us-east-1

# CRON
CRON_SECRET=fake_cron_secret

# -------------------------------------------------------------
# BACKEND RENDER NESTJS (.env)
# -------------------------------------------------------------

PORT=3001
NODE_ENV=development

# Core App Secrets
API_SECRET_KEY=your_backend_secret_key

# Cross Origin Setup
CORS_ORIGINS=http://localhost:3000,https://trackmyopt.com,https://www.trackmyopt.com

# Redis setup (Local fallback is handled if omitted)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
