# =============================================================================
# TrackMyOPT — Environment variables reference
# =============================================================================
# Copy to .env.local for local dev. In production, set these in Vercel
# Project Settings → Environment Variables.
#
# Grouped by feature so missing-secret errors at runtime are easy to fix.
# Required vs optional is determined by `apps/web/lib/env.ts` (zod schema).
# =============================================================================

# -------------------------------------------------------------
# CORE — required for any deployment
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...   # service role — server only
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # canonical site URL
JWT_SIGNING_SECRET=change-me-to-32-char-or-longer-string

# -------------------------------------------------------------
# STRIPE — required to enable premium billing
# -------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# -------------------------------------------------------------
# USCIS API — case status tracker (live production OAuth credentials)
# -------------------------------------------------------------
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
USCIS_TOKEN_URL=https://api.uscis.gov/oauth/accesstoken
USCIS_API_BASE_URL=https://api.uscis.gov/case-status
# USCIS_MOCK is ignored in production. Set to 'true' ONLY in local/preview to
# return canned data instead of hitting USCIS. Leave unset for live API.
USCIS_MOCK=false
NEXT_PUBLIC_USCIS_MOCK=false
# NEARBY_SCAN_ENABLED must remain false unless counsel + USCIS approve neighbor scanning.
# Default off — no runtime override path exists in code.
NEARBY_SCAN_ENABLED=false

# -------------------------------------------------------------
# AWS — Document Vault (S3) + Resume OCR (Textract)
# -------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=trackmyopt-prod-documents

# -------------------------------------------------------------
# AI — Gemini for resume + document analysis
# -------------------------------------------------------------
GEMINI_API_KEY=AIza...

# -------------------------------------------------------------
# EMAIL — SMTP (ZeptoMail, Resend SMTP, Hostinger, etc.)
# SMTP_USER is the SMTP login username — never use it as the From address.
# SMTP_FROM_EMAIL must be a sender verified at your provider (e.g. trackmyopt.com).
#
# ZeptoMail example:
#   SMTP_HOST=smtp.zeptomail.com
#   SMTP_PORT=465
#   SMTP_USER=emailapikey
#   SMTP_PASS=<ZeptoMail SMTP password from dashboard — store only in Vercel, never in git>
#
# Resend SMTP example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_USER=resend
#   SMTP_PASS=re_...
# -------------------------------------------------------------
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=465
SMTP_USER=emailapikey
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@trackmyopt.com
EMAIL_FROM_NAME=TrackMyOPT
CONTACT_EMAIL=support@trackmyopt.com

# -------------------------------------------------------------
# CRON / INTERNAL SECRETS — protect cron-triggered routes
# -------------------------------------------------------------
CRON_SECRET=long-random-string                 # cron-job.org auth (+ Vercel case-status cron)
API_SECRET_KEY=long-random-string              # for /api/cron/check-case-status → backend
SEO_PING_SECRET=long-random-string             # /api/seo/ping admin tool
INDEXNOW_KEY=your-bing-indexnow-key            # IndexNow key (public); /api/seo/ping uses this
EMAIL_LINK_SIGNING_SECRET=long-random-string   # HMAC for click-tracking links

# -------------------------------------------------------------
# ADMIN — server-only bulk email (policy / service announcements)
# -------------------------------------------------------------
ADMIN_SECRET=long-random-min-16-chars          # POST /api/admin/bulk-notification Authorization: Bearer …

# -------------------------------------------------------------
# RATE LIMITING — Upstash Redis (optional but recommended)
# -------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# -------------------------------------------------------------
# ANALYTICS — PostHog
# -------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# -------------------------------------------------------------
# OPTIONAL — local H-1B/LCA ETL scripts (apps/web/scripts/data/)
# Download DOL or ITContractorsUnion dataset; not needed for app runtime.
# -------------------------------------------------------------
# H1B_RAW_DATA_DIR=/path/to/ITContractorsUnion-Main

# -------------------------------------------------------------
# BACKEND (NestJS on Render) — for USCIS batch scrape via cron
# -------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.trackmyopt.com   # NestJS backend base URL
CORS_ORIGINS=http://localhost:3000,https://www.trackmyopt.com

# Backend-only (Render):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
