{
  "name": "trackmyopt-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=web",
    "vercel-build": "pnpm install && turbo run build --filter=web",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix --filter=web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=web",
    "test:e2e": "turbo run test:e2e --filter=web",
    "format": "turbo run format --filter=web",
    "format:check": "turbo run format:check --filter=web",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "submit:indexnow": "pnpm --filter web submit:indexnow",
    "submit:indexnow:url": "node scripts/submit-urls-indexnow.js"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "dompurify": "3.4.14",
      "fast-xml-builder": "1.3.1",
      "fast-xml-parser": "5.11.0",
      "file-type": "21.3.2",
      "glob": "10.5.0",
      "lodash": "4.18.1",
      "minimatch": "9.0.7",
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "protobufjs": "7.6.5",
      "qs": "6.15.3",
      "underscore": "1.13.8",
      "undici": "7.29.0",
      "uuid": "11.1.1",
      "ws": "8.21.3",
      "@xmldom/xmldom": "0.8.13",
      "path-to-regexp": "8.4.2"
    }
  }
}
