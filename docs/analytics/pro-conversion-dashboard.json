{
  "dashboard_id": 2195103,
  "name": "Paid Pro conversion improvements",
  "description": "Target two verified USD 0.99 starts daily. New events begin after deployment; zero before then is missing instrumentation, not zero business revenue.",
  "insights": [
    {
      "name": "Paid Pro starts per day \u2014 target 2",
      "description": "Unique people with a live, completed, paid USD 0.99 Pro introductory checkout. Target >=2 each complete day. New instrumentation; no historical backfill. Excludes configured test accounts.",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "series": [
            {
              "kind": "EventsNode",
              "event": "pro_paid_intro_started",
              "properties": [],
              "math": "dau"
            }
          ],
          "dateRange": {
            "date_from": "-28d",
            "date_to": "-1d"
          },
          "interval": "day",
          "filterTestAccounts": true,
          "properties": [],
          "trendsFilter": {
            "display": "ActionsLineGraph"
          }
        }
      },
      "insight_id": 12731141,
      "short_id": "cQAyhLTx"
    },
    {
      "name": "Paid Pro starts \u2014 last 7 complete days vs target 14",
      "description": "All project actors; server verified live payments only. 14 per week is a pacing target, not proof every day reached 2. No historical backfill.",
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT uniq(person_id) AS paid_people, 14 AS weekly_target, 14-uniq(person_id) AS gap_to_target FROM events WHERE event='pro_paid_intro_started' AND timestamp >= toStartOfDay(now()) - INTERVAL 7 DAY AND timestamp < toStartOfDay(now())"
        }
      },
      "insight_id": 12731142,
      "short_id": "RJWGJwdu"
    },
