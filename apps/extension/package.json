{
  "name": "extension",
  "version": "0.2.0",
  "private": true,
  "description": "TrackMyOPT Chrome Extension",
  "scripts": {
    "dev": "node esbuild.config.js --watch",
    "dev:local": "EXT_TARGET=local node esbuild.config.js --watch",
    "build": "node esbuild.config.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "test:opt-browser": "node scripts/test-opt-tools-browser.mjs",
    "test:undo-browser": "node scripts/test-prefill-undo-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/chrome": "^0.0.254",
    "@types/node": "^24.8.1",
    "esbuild": "^0.19.11",
    "jsdom": "29.0.1",
    "typescript": "^5.3.3"
  }
}
