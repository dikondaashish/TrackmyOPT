{
  "manifest_version": 3,
  "name": "TrackMyOPT",
  "version": "0.1.6",
  "description": "Track your OPT timeline with precision",
  "permissions": ["storage", "tabs", "notifications", "scripting"],
  "host_permissions": [
    "https://www.trackmyopt.com/*",
    "https://trackmyopt.com/*"
  ],
  "externally_connectable": {
    "matches": ["https://www.trackmyopt.com/*", "https://trackmyopt.com/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.trackmyopt.com/*", "https://trackmyopt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.linkedin.com/jobs/*",
        "*://linkedin.com/jobs/*",
        "*://www.indeed.com/*",
        "*://indeed.com/*",
        "*://www.glassdoor.com/*",
        "*://glassdoor.com/*",
        "*://www.monster.com/*",
        "*://monster.com/*",
        "*://www.ziprecruiter.com/*",
        "*://ziprecruiter.com/*",
        "*://www.simplyhired.com/*",
        "*://simplyhired.com/*",
        "*://www.careerbuilder.com/*",
        "*://careerbuilder.com/*",
        "*://www.dice.com/*",
        "*://dice.com/*",
        "*://www.naukri.com/*",
        "*://naukri.com/*",
        "*://www.shine.com/*",
        "*://shine.com/*",
        "*://www.foundit.in/*",
        "*://foundit.in/*",
        "*://www.instahyre.com/*",
        "*://instahyre.com/*",
        "*://apna.co/*",
        "*://www.apna.co/*",
        "*://wellfound.com/*",
        "*://www.wellfound.com/*",
        "*://weworkremotely.com/*",
        "*://www.weworkremotely.com/*",
        "*://remote.co/*",
        "*://www.remote.co/*",
        "*://www.flexjobs.com/*",
        "*://flexjobs.com/*",
        "*://hired.com/*",
        "*://www.hired.com/*",
        "*://joinhandshake.com/*",
        "*://app.joinhandshake.com/*",
        "*://internshala.com/*",
        "*://www.internshala.com/*",
        "*://www.freshersworld.com/*",
        "*://freshersworld.com/*",
        "*://www.timesjobs.com/*",
        "*://timesjobs.com/*",
        "*://www.iimjobs.com/*",
        "*://iimjobs.com/*",
        "*://cutshort.io/*",
        "*://www.cutshort.io/*",
        "*://otta.com/*",
        "*://www.otta.com/*",
        "*://builtin.com/*",
        "*://www.builtin.com/*",
        "*://getwork.org/*",
        "*://www.getwork.org/*",
        "*://www.naukrigulf.com/*",
        "*://naukrigulf.com/*",
        "*://www.bayt.com/*",
        "*://bayt.com/*",
        "*://www.gulftalent.com/*",
        "*://gulftalent.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.greenhouse.io/*",
        "*://jobs.lever.co/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.brassring.com/*",
        "*://*.successfactors.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.jazzhr.com/*",
        "*://*.bamboohr.com/*",
        "*://*.recruitee.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.jobvite.com/*",
        "*://*.comeet.com/*",
        "*://dover.com/*",
        "*://www.dover.com/*",
        "*://*.workable.com/*",
        "*://*.teamtailor.com/*",
