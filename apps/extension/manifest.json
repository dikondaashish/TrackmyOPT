        "*://rippling.com/jobs*",
        "*://*.pinpointhq.com/*",
        "*://*.applytojob.com/*",
        "*://*.breezyhr.com/*",
        "*://*.freshteam.com/*",
        "*://*.oraclecloud.com/*",
        "*://*/careers",
        "*://*/careers/*",
        "*://*/job",
        "*://*/job/*",
        "*://*/jobs",
        "*://*/jobs/*",
        "*://*/career",
        "*://*/career/*",
        "*://*/join",
        "*://*/join/*",
        "*://*/join-us",
        "*://*/join-us/*",
        "*://*/work-with-us",
        "*://*/work-with-us/*",
        "*://*/openings",
        "*://*/openings/*",
        "*://*/vacancies",
        "*://*/vacancies/*",
        "*://*/opportunities",
        "*://*/opportunities/*",
        "*://*/hiring",
        "*://*/hiring/*",
        "*://*/apply",
        "*://*/apply/*"
      ],
      "exclude_matches": [
        "https://chrome.google.com/*",
        "https://chromewebstore.google.com/*"
      ],
      "js": ["content-job-portal.js"],
      "run_at": "document_idle"
    }
  ]
