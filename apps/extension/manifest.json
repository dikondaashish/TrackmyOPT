{
  "manifest_version": 3,
  "name": "TrackMyOPT",
  "version": "0.1.1",
  "description": "Track your OPT timeline with precision",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://trackmyopt-*.vercel.app/*",
    "https://www.trackmyopt.com/*",
    "https://trackmyopt.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://trackmyopt-*.vercel.app/*",
      "https://www.trackmyopt.com/*",
      "https://trackmyopt.com/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://trackmyopt-*.vercel.app/*",
        "https://www.trackmyopt.com/*",
        "https://trackmyopt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}