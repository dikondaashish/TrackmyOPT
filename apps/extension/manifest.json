{
  "manifest_version": 3,
  "name": "TrackMyOPT",
  "version": "0.1.19",
  "description": "Manage OPT and job applications with review-first prefill and job tracking. Never auto-submits.",
  "permissions": ["storage", "tabs", "notifications", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.trackmyopt.com/*",
    "https://trackmyopt.com/*"
  ],
  "externally_connectable": {
    "matches": ["https://www.trackmyopt.com/*", "https://trackmyopt.com/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.trackmyopt.com/*", "https://trackmyopt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
