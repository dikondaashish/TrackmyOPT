# TrackMyOPT — Stripe TEST mode overrides (local billing validation only)
#
# 1. Copy to .env.test.local (gitignored):  cp .env.test.local.example .env.test.local
# 2. Fill values from Stripe Dashboard → Test mode → Developers → API keys + Products
# 3. Start dev with .env.local first, then override from .env.test.local (see docs)
#
# NEVER commit .env.test.local. NEVER add these values to Vercel Production/Preview.

# --- Stripe test API keys ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# From: stripe listen --forward-to localhost:3000/api/premium/webhook
# (or a Test-mode webhook endpoint in Stripe Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Test-mode Price IDs (Products → each plan → copy price_... in Test mode) ---
STRIPE_PRICE_PRO_MONTHLY=price_test_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_test_pro_yearly_id
STRIPE_PRICE_DEDICATED_MONTHLY=price_test_dedicated_monthly_id
STRIPE_PRICE_DEDICATED_YEARLY=price_test_dedicated_yearly_id

# Optional: test-mode promotion code IDs (promo_...) — leave empty if not testing promos
STRIPE_PROMO_CODE_PRO=
STRIPE_PROMO_CODE_DEDICATED=

# --- PostHog (reuse project 369087 from .env.local; uncomment only if not in .env.local) ---
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Supabase ---
# By default, .env.local points at production Supabase. For safer isolation, use a staging
# Supabase project and override here:
# NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
