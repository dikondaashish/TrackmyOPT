# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OPT Hub

# Backend API URL (for local development)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backend API Authentication Key
API_SECRET_KEY=your-api-secret-key-here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (not exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Signing Secret (use: openssl rand -hex 64)
# Generate with: openssl rand -base64 32
JWT_SIGNING_SECRET=your-jwt-signing-secret-change-this-in-production

# Google OAuth Configuration
# Note: Supabase handles OAuth server-side using your dashboard configuration

# SMTP Email Configuration (Hostinger)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these prices in Stripe Dashboard -> Products
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id
STRIPE_PRICE_DEDICATED_MONTHLY=price_dedicated_monthly_id
STRIPE_PRICE_DEDICATED_YEARLY=price_dedicated_yearly_id

# Optional: customer-facing promo code shown before Stripe (e.g. EARLYBIRD). Not the Stripe promo id (promo_...).
# STRIPE_CHECKOUT_PROMO_HINT=EARLYBIRD
#   → same code for all four checkouts: Pro monthly, Pro yearly, Dedicated monthly, Dedicated yearly
# Optional overrides (else fall back to STRIPE_CHECKOUT_PROMO_HINT):
# STRIPE_CHECKOUT_PROMO_HINT_PRO=EARLYBIRD
# STRIPE_CHECKOUT_PROMO_HINT_DEDICATED=EARLYBIRD

# Legacy: force-apply Stripe promotion code ids and hide customer promo field on hosted Checkout (users cannot remove).
# STRIPE_LOCK_CHECKOUT_PROMO=true
# STRIPE_PROMO_CODE_PRO=promo_...
# STRIPE_PROMO_CODE_DEDICATED=promo_...
