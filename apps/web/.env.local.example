# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OPT Hub

# Backend API URL (for local development)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backend API Authentication Key
NEXT_PUBLIC_API_SECRET_KEY=your-api-secret-key-here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (not exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Signing Secret (use: openssl rand -hex 64)
# Generate with: openssl rand -base64 32
JWT_SIGNING_SECRET=your-jwt-signing-secret-change-this-in-production

# Google OAuth Configuration
# Note: Supabase handles OAuth server-side using your dashboard configuration
# Client ID stored here for reference only
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP Email Configuration (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password
EMAIL_FROM_NAME=TrackMyOPT

# CRON Secret (for securing cron endpoints)
CRON_SECRET=your-random-secret-here

# Chrome Extension Configuration
# Extension ID from Chrome Web Store (get this after publishing)
NEXT_PUBLIC_CHROME_EXTENSION_ID=your-extension-id-here
# Chrome Web Store URL for the extension
NEXT_PUBLIC_CHROME_STORE_URL=https://chrome.google.com/webstore/detail/trackmyopt/your-extension-id-here

# Stripe Configuration (Subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these prices in Stripe Dashboard -> Products
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id
STRIPE_PRICE_DEDICATED_MONTHLY=price_dedicated_monthly_id
STRIPE_PRICE_DEDICATED_YEARLY=price_dedicated_yearly_id
