# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OPT Hub
NEXT_PUBLIC_CHROME_EXTENSION_ID=hfljbefkccdmlnhclfojlafipjnjbajm
# Optional comma-separated unpacked/dev IDs accepted by extension-facing CORS routes.
CHROME_EXTENSION_IDS=

# Backend API URL (for local development)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backend API Authentication Key
API_SECRET_KEY=your-api-secret-key-here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (not exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Signing Secret (use: openssl rand -hex 64)
# Generate with: openssl rand -base64 32
JWT_SIGNING_SECRET=your-jwt-signing-secret-change-this-in-production
# Generate once with: openssl rand -base64 32
# Server-only; never prefix with NEXT_PUBLIC_.
PRIVATE_APPLICATION_ANSWERS_ENCRYPTION_KEY=

# Google OAuth Configuration
# Note: Supabase handles OAuth server-side using your dashboard configuration

# SMTP Email Configuration (Hostinger)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these prices in Stripe Dashboard -> Products
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id
STRIPE_PRICE_DEDICATED_MONTHLY=price_dedicated_monthly_id
STRIPE_PRICE_DEDICATED_YEARLY=price_dedicated_yearly_id

# Optional: Stripe Promotion Code IDs (promo_...) for auto-applying EARLYBIRD at checkout.
# Each ID should be configured in Stripe to apply to all prices for that plan (monthly + yearly).
# STRIPE_PROMO_CODE_PRO → Pro monthly + Pro yearly | STRIPE_PROMO_CODE_DEDICATED → Dedicated monthly + yearly
STRIPE_PROMO_CODE_PRO=
STRIPE_PROMO_CODE_DEDICATED=
