{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "analyze": "ANALYZE=true next build",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "submit:indexnow": "node ../../scripts/submit-to-indexnow.js",
    "submit:indexnow:url": "node ../../scripts/submit-urls-indexnow.js",
    "policy-notice:dry-run": "npx tsx scripts/send-policy-update-notice.ts --dry-run",
    "policy-notice:send-test": "npx tsx scripts/send-policy-update-notice.ts --test-email support@trackmyopt.com --send",
    "email-previews:dry-run": "npx tsx scripts/send-all-email-previews.ts --dry-run",
    "email-previews:send": "npx tsx scripts/send-all-email-previews.ts --to support@trackmyopt.com",
    "posthog:ops-closure": "npx tsx scripts/posthog-ops-closure.ts",
    "posthog:ops-closure:dry-run": "npx tsx scripts/posthog-ops-closure.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/client-textract": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.44.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.39.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.25",
    "jose": "^5.2.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.545.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pdfjs-dist": "^6.2.108",
    "posthog-js": "^1.421.0",
    "posthog-node": "^5.51.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.2.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.22.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "^1.58.2",
    "@posthog/nextjs-config": "^1.9.68",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.0",
    "autoprefixer": "^10.4.17",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^29.0.1",
    "knip": "^5.36.5",
    "postcss": "^8.4.33",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ]
}
