{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/pending-case-emails",
      "schedule": "45 * * * *"
    },
    {
      "path": "/api/cron/send-case-digests",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/send-case-deadline-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/job-board-ingestion-health",
      "schedule": "20 */3 * * *"
    },
    {
      "path": "/api/cron/check-case-status",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/ingest-community-opt",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/refresh-opt-forecasts",
      "schedule": "15 16,18,20 * * *"
    },
    {
      "path": "/api/cron/checkout-recovery-emails",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/d1-activation-nudge",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/retry-pending-emails",
      "schedule": "15 * * * *"
    }
  ]
}
